# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Build & capture artefacts
*.bin
*.elf
*.map
!data/**/*.bin

# Secrets — API keys and WiFi credentials live on-device (NVS), never in git.
# include/secrets.h is a build-time convenience for provisioning a fresh
# device; include/secrets_example.h is the committed template.
secrets.h
include/secrets.h
credentials.json

# macOS
.DS_Store

# Release scratch space. The release workflow assembles firmware-<v>.bin, its
# .sha sidecar and manifest.json here before attaching them to the GitHub
# release. None of it belongs in the repository: the manifest is an asset of
# the release it describes, not a file tracked on main.
firmware/
firmware-*.bin
firmware-*.bin.sha
